FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

ARG PIPELINE_EXTRAS=""

# Install only what the silver/gold pipeline needs.
RUN pip install --no-cache-dir -U pip setuptools wheel

# Install the internal pipeline package (numpy/pandas/python-dotenv).
COPY pipeline/ ./pipeline/
RUN if [ -n "$PIPELINE_EXTRAS" ]; then \
        pip install --no-cache-dir "./pipeline[$PIPELINE_EXTRAS]"; \
    else \
        pip install --no-cache-dir ./pipeline; \
    fi

# Copy step scripts.
COPY scripts/ ./scripts/
COPY tools/ ./tools/

# Default command is provided by docker-compose.yml
